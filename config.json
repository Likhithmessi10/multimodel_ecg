{
  "project_name": "Multi-Modal ECG Diagnostics",
  "data": {
    "data_dir": "./data",
    "cache_dir": "./data/cache",
    "fs": 100,
    "num_classes": 5,
    "superclasses": ["NORM", "MI", "STTC", "CD", "HYP"],
    "metadata_cols": ["age", "sex", "height", "weight"]
  },
  "training": {
    "seed": 42,
    "epochs": 15,
    "batch_size": 64,
    "lr": 0.001,
    "weight_decay": 1e-4,
    "patience": 5,
    "subset_size": null,
    "run_cv": false,
    "use_tb": true
  },
  "model_hyperparameters": {
    "mc_dropout_rate": 0.2,
    "signal_branch": {
      "in_channels": 12,
      "out_dim": 64
    },
    "metadata_branch": {
      "in_features": 4,
      "out_dim": 16
    },
    "inception_time": {
      "depth": 3,
      "hidden_dim": 32
    },
    "transformer_ecg": {
      "d_model": 64,
      "nhead": 4,
      "num_layers": 2,
      "dim_feedforward": 128
    },
    "xgboost": {
      "n_estimators": 100,
      "learning_rate": 0.05,
      "max_depth": 5
    }
  },
  "uncertainty": {
    "mc_dropout_steps": 30,
    "entropy_threshold": 0.75
  },
  "robustness": {
    "gaussian_noise_stds": [0.05, 0.15, 0.30],
    "baseline_wander_frequencies": [0.15],
    "baseline_wander_amplitudes": [0.2, 0.4, 0.6],
    "lead_dropout_ratios": [0.17, 0.33, 0.50]
  },
  "explainability": {
    "grad_cam_target_layer": "signal_branch.prep.0",
    "integrated_gradients_steps": 50
  },
  "fairness": {
    "age_threshold": 65,
    "bmi_overweight_threshold": 25.0
  },
  "statistical_validation": {
    "bootstrap_iterations": 200,
    "confidence_level": 0.95
  }
}
